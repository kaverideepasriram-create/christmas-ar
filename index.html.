
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Christmas AR Wonderland</title>

<script type="module"
src="https://ajax.googleapis.com/ajax/libs/model-viewer/4.0.0/model-viewer.min.js">
</script>

<style>
* { box-sizing: border-box; }

body {
  margin: 0;
  font-family: Arial, sans-serif;
  text-align: center;
  color: white;
  background: linear-gradient(160deg, #082e25, #176044, #092b24);
  min-height: 100vh;
}

header { padding: 30px 15px; }

h1 { color: #f8d77b; font-size: 34px; }

.subtitle { color: #f4eee2; }

.gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 25px;
  padding: 20px;
}

.character {
  width: min(100%, 550px);
}

model-viewer {
  width: 100%;
  height: 430px;
  background: #edf1e9;
  border-radius: 20px;
  --poster-color: #edf1e9;
}

.ar-button {
  position: absolute;
  bottom: 20px;
  right: 20px;
  background: #b51e31;
  color: white;
  border: none;
  border-radius: 25px;
  padding: 13px 20px;
  font-size: 15px;
  cursor: pointer;
}

h2 { color: #f8d77b; }

footer {
  padding: 25px;
  font-size: 13px;
}
</style>
</head>

<body>

<header>
<h1>Christmas AR Wonderland</h1>
<p class="subtitle">Bring Christmas magic into your world!</p>
</header>

<div class="gallery">

<section class="character">
<model-viewer
src="santa.glb"
alt="Santa Claus"
ar
ar-modes="webxr scene-viewer quick-look"
ar-placement="floor"
camera-controls
auto-rotate
shadow-intensity="1">

<button slot="ar-button" class="ar-button">
View Santa in AR
</button>
</model-viewer>

<h2>Santa Claus</h2>
<p>Meet Santa in augmented reality!</p>
</section>

<section class="character">
<model-viewer
src="gingerbread.glb"
alt="Gingerbread Man"
ar
ar-modes="webxr scene-viewer quick-look"
ar-placement="floor"
camera-controls
auto-rotate
shadow-intensity="1">

<button slot="ar-button" class="ar-button">
View Gingerbread in AR
</button>
</model-viewer>

<h2>Gingerbread Man</h2>
<p>Meet our sweet Christmas character!</p>
</section>

</div>

<footer>
Created using Meshy AI and GitHub
</footer>

</body>
</html>
